<?xml version="1.0" encoding="utf-8"?>
<!-- Circular brand container for the biometric gate hero icon. Tonal surface with a
     hairline stroke; reads in both light and dark mode via semantic color tokens. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_tonal" />
            <stroke android:width="1dp" android:color="@color/stroke" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="@color/ambient_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
