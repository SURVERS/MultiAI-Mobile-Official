<?xml version="1.0" encoding="utf-8"?>
<!-- Чип авторизации в карточке ошибки: мягкая индиго-подложка, чтобы выделить
     действие «Войти» среди нейтральных чипов, но без белой заливки. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/error_auth_soft_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/error_auth_soft_border" />
    <corners android:radius="9dp" />
</shape>
