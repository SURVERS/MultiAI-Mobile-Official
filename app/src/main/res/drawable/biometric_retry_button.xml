<?xml version="1.0" encoding="utf-8"?>
<!-- Primary retry button for the biometric gate. Uses the accent fill (monochrome /
     themed) with ripple for Material touch feedback. Kept as a separate drawable so
     the gate's disabled state can swap to control_disabled without touching global
     styles. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
