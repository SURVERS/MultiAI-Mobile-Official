    when there is no embedded artwork (the music-note glyph sits on top of it).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_tonal" />
    <corners android:radius="20dp" />
</shape>
