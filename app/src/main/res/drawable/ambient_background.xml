<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
        </shape>
    </item>
    <item
        android:top="-180dp"
        android:left="-120dp"
        android:right="80dp"
        android:bottom="360dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:centerX="0.2"
                android:centerY="0.15"
                android:startColor="@color/ambient_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:top="420dp"
        android:left="120dp"
        android:right="-180dp"
        android:bottom="-220dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="360dp"
                android:centerX="0.8"
                android:centerY="0.85"
                android:startColor="@color/ambient_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
