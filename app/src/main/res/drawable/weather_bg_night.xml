<?xml version="1.0" encoding="utf-8"?>
<!-- Ночь: тёмно-фиолетовая. Fixed dark gradient (not the theme surface token) so
     the always-white foreground keeps contrast in both light and dark themes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="135"
        android:startColor="#1E1B4B"
        android:centerColor="#172554"
        android:endColor="#0F172A" />
    <corners android:radius="22dp" />
</shape>
