<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.MultiAiIde" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorOnPrimary">@color/icon_on_accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <!-- Light status-bar icons in light mode, dark icons in dark mode -->
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
        <item name="android:windowLightNavigationBar">@bool/light_status_bar</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/ambient_background</item>
        <!-- Smooth cross-fade for all activity transitions -->
        <item name="android:windowAnimationStyle">@style/Animation.MultiAiIde.Activity</item>
    </style>

    <style name="Theme.MultiAiIde" parent="Base.Theme.MultiAiIde" />

    <!-- Fullscreen black theme for the QR scanner (no action bar, black bars). -->
    <style name="Theme.MultiAiIde.Fullscreen" parent="Theme.MultiAiIde">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Black launch window used only by the launcher activity. The Activity
         restores the normal semantic background after its custom logo cycle. -->
    <style name="Theme.MultiAiIde.Starting" parent="Theme.MultiAiIde">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.MultiAiIde.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:background">@color/bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowAnimationStyle">@style/Animation.MultiAiIde.Activity</item>
    </style>

    <!-- Custom activity transitions: gentle shared fade in/out (no slide) -->
    <style name="Animation.MultiAiIde.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>

    <!-- Drawer navigation item typography -->
    <style name="DrawerMenuItem" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ShapeAppearance overlay used by the editor audio player album-art tile
         (ShapeableImageView). Rounded-square, ~12% radius. -->
    <style name="AudioAlbumArtShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
