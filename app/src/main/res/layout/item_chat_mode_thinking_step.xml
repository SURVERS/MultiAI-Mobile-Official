<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingBottom="9dp">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:minHeight="64dp">

        <View
            android:id="@+id/thinkingStepLine"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="@color/thinking_card_stroke" />

        <View
            android:id="@+id/thinkingStepDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/chat_mode_thinking_dot" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/thinkingStepCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="64dp"
        android:background="@drawable/chat_mode_thinking_step_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/thinkingStepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/thinkingStepBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/thinkingStepCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_check_circle"
            android:tint="@color/thinking_accent"
            android:contentDescription="@null"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
