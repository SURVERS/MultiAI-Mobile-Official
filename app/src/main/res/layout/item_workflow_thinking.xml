<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="4dp">

    <!-- Заголовок thinking -->
    <LinearLayout
        android:id="@+id/thinkingHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <app.multiai.mobile.ui.ThinkingWaveIconView
            android:id="@+id/thinkingWaveIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_reasoning_spark"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/thinkingPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/lay_thinking_process"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif" />

        <ImageView
            android:id="@+id/thinkingToggle"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_down"
            android:layout_marginStart="8dp"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Контент thinking -->
    <app.multiai.mobile.views.MaxHeightNestedScrollView
        android:id="@+id/thinkingScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/reasoning_expanded_background"
        app:maxHeightCompat="220dp"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:scrollbars="vertical"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls">

        <TextView
            android:id="@+id/textThinking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:textIsSelectable="true"
            android:lineSpacingExtra="3dp"
            android:visibility="visible" />
    </app.multiai.mobile.views.MaxHeightNestedScrollView>
</LinearLayout>
