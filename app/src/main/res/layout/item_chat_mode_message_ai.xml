<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Спокойный inline thinking-блок только для Chat Mode. -->
    <LinearLayout
        android:id="@+id/thinkingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/chat_mode_thinking_bg"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/thinkingHeader"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <app.multiai.mobile.ui.ThinkingWaveIconView
                android:id="@+id/thinkingWaveIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_reasoning_spark"
                android:layout_marginEnd="9dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/thinkingPreview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <ImageView
                android:id="@+id/thinkingToggle"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_down"
                android:layout_marginStart="8dp"
                android:tint="@color/icon_muted"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/thinkingBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="11dp"
                android:background="@color/thinking_card_stroke" />

            <app.multiai.mobile.views.MaxHeightNestedScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:maxHeightCompat="220dp"
                android:scrollbars="vertical"
                android:fadeScrollbars="true"
                android:fillViewport="false"
                android:overScrollMode="ifContentScrolls">

                <TextView
                    android:id="@+id/textThinking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="5dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:textIsSelectable="true"
                    android:lineSpacingExtra="3dp" />
            </app.multiai.mobile.views.MaxHeightNestedScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Generated image (image-model turns) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/imageCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false">

        <ImageView
            android:id="@+id/imageAttachment"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:minHeight="80dp"
            android:maxHeight="320dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/lay_cd_attached_image" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/textMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textColorLink="@color/text_secondary"
        android:textSize="16sp"
        android:lineSpacingExtra="5dp" />

    <!-- Полноформатный рендер (LaTeX/кодблоки/Mermaid) — тот же пайплайн,
         что и в Work-режиме (MarkdownRenderer.renderToLayout). Показывается
         вместо textMessage, если в ответе есть формулы или код-блоки. -->
    <LinearLayout
        android:id="@+id/richContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnCopy"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:src="@drawable/ic_copy"
            android:contentDescription="@string/act_copy"
            android:tooltipText="@string/act_copy"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btnLike"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:padding="12dp"
            android:src="@drawable/ic_like"
            android:contentDescription="@string/act_like"
            android:tooltipText="@string/act_like"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btnDislike"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:padding="12dp"
            android:src="@drawable/ic_dislike"
            android:contentDescription="@string/act_dislike"
            android:tooltipText="@string/act_dislike"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btnTts"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:padding="12dp"
            android:src="@drawable/ic_volume"
            android:contentDescription="@string/act_listen"
            android:tooltipText="@string/act_listen"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/act_more"
            android:tooltipText="@string/act_more"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/variantPager"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:visibility="gone">
        <ImageButton
            android:id="@+id/variantPrev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_previous_variant"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/icon_muted" />
        <TextView
            android:id="@+id/variantIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <ImageButton
            android:id="@+id/variantNext"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_next_variant"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/icon_muted" />
    </LinearLayout>

</LinearLayout>
