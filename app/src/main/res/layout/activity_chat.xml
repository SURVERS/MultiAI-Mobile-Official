<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/chat_background">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:contentInsetStart="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/toolbarContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/buttonMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_hamburger"
                    android:tint="@color/icon"
                    android:padding="12dp"
                    android:contentDescription="@string/menu"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/brandingPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    app:layout_constraintStart_toEndOf="@id/buttonMenu"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <FrameLayout
                    android:id="@+id/modePillContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:foregroundGravity="center"
                    app:layout_constraintEnd_toStartOf="@id/btnNewChat"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageButton
                    android:id="@+id/btnNewChat"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_plus"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/chat_new_chat"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/btnModelSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:maxWidth="160dp"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:text="@string/lay_default_chat_model"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:drawableEnd="@drawable/ic_chevron_down"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/text_secondary"
                    android:background="@drawable/model_selector_bg"
                    android:elevation="2dp"
                    android:outlineAmbientShadowColor="@color/shadow_ambient"
                    android:outlineSpotShadowColor="@color/shadow_spot"
                    app:layout_constraintEnd_toStartOf="@id/btnNewChat"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.Toolbar>

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintBottom_toTopOf="@id/inputContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/emptyStateLogo"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_multiai_logo" />

                <TextView
                    android:id="@+id/emptyStateBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <TextView
                android:id="@+id/textEmptyTyping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:minHeight="28dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:fontFamily="monospace"
                android:gravity="center_horizontal"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintBottom_toTopOf="@id/inputContainer" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabScrollDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_arrow_down"
            android:visibility="gone"
            android:elevation="6dp"
            app:fabSize="mini"
            app:backgroundTint="@color/surface_tonal"
            app:tint="@color/icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/inputContainer" />

        <LinearLayout
            android:id="@+id/inputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="0dp"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Attach menu popup (hidden by default) -->
            <LinearLayout
                android:id="@+id/attachMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/attach_menu_background"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:paddingHorizontal="20dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone">

                <!-- Camera -->
                <LinearLayout
                    android:id="@+id/btnAttachCamera"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/icon" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lay_chat_attach_camera"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Photo -->
                <LinearLayout
                    android:id="@+id/btnAttachPhoto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_photo"
                        android:tint="@color/icon" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lay_chat_attach_photo"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Files -->
                <LinearLayout
                    android:id="@+id/btnAttachFile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_file_attach"
                        android:tint="@color/icon" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/files"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Animated capsule input shared with just-chatting mode -->
            <androidx.constraintlayout.motion.widget.MotionLayout
                android:id="@+id/inputMotionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="0dp"
                app:layoutDescription="@xml/scene_chat_input">

                <LinearLayout
                    android:id="@+id/inputBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/chat_mode_input_bg"
                    android:elevation="5dp"
                    android:minHeight="52dp"
                    android:outlineAmbientShadowColor="@color/shadow_ambient"
                    android:outlineSpotShadowColor="@color/shadow_spot">

                    <!-- Превью вложения — ВНУТРИ поля ввода (стиль ChatGPT).
                         Старые id (imagePreview и т.д.) маппим в коде. -->
                    <include
                        layout="@layout/view_attachment_inline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:id="@+id/inputRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp">

                    <FrameLayout
                        android:id="@+id/standardInputGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp">

                    <EditText
                        android:id="@+id/editMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:background="@android:color/transparent"
                        android:hint="@string/ask_multiai"
                        android:imeOptions="actionSend"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="5"
                        android:paddingStart="48dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="72dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <ImageButton
                        android:id="@+id/buttonMic"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/lay_chat_cd_voice_input"
                        android:padding="12dp"
                        android:src="@drawable/ic_mic"
                        android:tint="@color/icon"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/buttonSend"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/chat_mode_send_bg"
                        android:backgroundTint="@color/accent"
                        android:contentDescription="@string/send"
                        android:padding="7dp"
                        android:src="@drawable/ic_arrow_up"
                        android:tint="@color/icon_on_accent" />

                    <ImageButton
                        android:id="@+id/buttonStop"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/chat_mode_send_bg"
                        android:backgroundTint="@color/accent"
                        android:contentDescription="@string/lay_chat_cd_stop"
                        android:padding="8dp"
                        android:src="@drawable/ic_stop"
                        android:tint="@color/icon_on_accent"
                        android:visibility="gone" />

                    </FrameLayout>

                    <!-- ═══ VOICE RECORDING GROUP (matches Chat Mode) ═══ -->
                    <LinearLayout
                        android:id="@+id/voiceInputGroup"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="6dp"
                        android:visibility="gone"
                        android:alpha="0">

                        <app.multiai.mobile.ui.VoiceWaveformView
                            android:id="@+id/voiceWaveform"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp" />

                        <ImageButton
                            android:id="@+id/btnVoiceStop"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/voice_circle_bg"
                            android:contentDescription="@string/stop"
                            android:padding="12dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_stop"
                            android:tint="@color/icon" />

                        <ImageButton
                            android:id="@+id/btnVoiceSend"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/chat_mode_send_bg"
                            android:backgroundTint="@color/accent"
                            android:contentDescription="@string/send_voice"
                            android:padding="10dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_arrow_up"
                            android:tint="@color/icon_on_accent" />
                    </LinearLayout>

                    <!-- ═══ TRANSCRIBING GROUP (matches Chat Mode) ═══ -->
                    <LinearLayout
                        android:id="@+id/transcribingGroup"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone"
                        android:alpha="0">

                        <View
                            android:id="@+id/transcribeDot1"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/chat_mode_typing_dot" />

                        <View
                            android:id="@+id/transcribeDot2"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/chat_mode_typing_dot" />

                        <View
                            android:id="@+id/transcribeDot3"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/chat_mode_typing_dot" />

                        <TextView
                            android:id="@+id/transcribeLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="@string/transcribing"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    </FrameLayout>

                </LinearLayout>

                <View
                    android:id="@+id/btnAttachCircleBg"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:alpha="0"
                    android:background="@drawable/voice_circle_bg"
                    android:clickable="false"
                    android:elevation="4dp"
                    android:focusable="false"
                    android:outlineAmbientShadowColor="@color/shadow_ambient"
                    android:outlineSpotShadowColor="@color/shadow_spot" />

                <ImageButton
                    android:id="@+id/btnAttach"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/attach"
                    android:elevation="5dp"
                    android:focusable="true"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_plus"
                    android:tint="@color/icon"
                    android:translationZ="2dp" />

            </androidx.constraintlayout.motion.widget.MotionLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer -->
    <include layout="@layout/drawer_navigation" />

</androidx.drawerlayout.widget.DrawerLayout>
