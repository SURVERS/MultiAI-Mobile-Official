<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: match the custom black stage so the handoff
         is seamless, then let OnboardingActivity run the full four-part loop. -->
    <style name="Theme.MultiAiIde.Starting" parent="Theme.MultiAiIde">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_multiai_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
